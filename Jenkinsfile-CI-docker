pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    timestamps()
    skipDefaultCheckout(true)
    timeout(time: 35, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  environment {
    GIT_URL = 'https://github.com/hyunooss/myfirst-api-server.git'
    GIT_BRANCH = 'main'
    GIT_ID = 'sk026-github-id'
    APP_DIR = '01.spring-backend-v1.0'
    IMAGE_NAME = 'sk026-webserver'
    IMAGE_TAG = 'p175-docker'
    CI_TOOL = 'docker'
    GITOPS_BRANCH = 'gitops'
    IMAGE_REGISTRY_URL = 'skala-registry.skala-us.com'
    IMAGE_REGISTRY_PROJECT = 'class-1'
    DOCKER_CREDENTIAL_ID = 'sk026-image-registry-id'
    K8S_NAMESPACE = 'class-1'
  }
  stages {
    stage('Clone Repository') {
      steps {
        git branch: env.GIT_BRANCH, url: env.GIT_URL, credentialsId: env.GIT_ID
        script {
          env.SOURCE_REV = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          env.FINAL_IMAGE_TAG = "${env.IMAGE_TAG}-${env.BUILD_NUMBER}-${env.SOURCE_REV.substring(0,7)}"
        }
        sh '''#!/bin/bash
set -euo pipefail
mkdir -p evidence
printf '%s\n' "$SOURCE_REV" > evidence/source-revision.txt
printf '%s/%s/%s:%s\n' "$IMAGE_REGISTRY_URL" "$IMAGE_REGISTRY_PROJECT" "$IMAGE_NAME" "$FINAL_IMAGE_TAG" > evidence/image-ref.txt
'''
      }
    }
    stage('Build with Maven') {
      steps {
        writeFile file: 'maven-settings.xml', text: '<settings><mirrors><mirror><id>google-central</id><url>https://maven-central.storage-download.googleapis.com/maven2</url><mirrorOf>central</mirrorOf></mirror></mirrors></settings>'
        dir(env.APP_DIR) { sh 'mvn -B -ntp -s ../maven-settings.xml clean package -DskipTests' }
        sh '''#!/bin/bash
set -euo pipefail
mkdir -p image-context/target
cp "$APP_DIR/target/myapp-0.0.1-SNAPSHOT.jar" image-context/target/
sed 's|^FROM eclipse-temurin:|FROM docker.io/library/eclipse-temurin:|' "$APP_DIR/Dockerfile" > image-context/Dockerfile
sha256sum image-context/target/*.jar > evidence/jar-sha256.txt
'''
      }
    }
    stage('Compute Image Meta') {
      steps {
        echo "Image tag: ${env.FINAL_IMAGE_TAG}; source: ${env.SOURCE_REV}"
        sh '''#!/bin/bash
set -euo pipefail
printf '\nLABEL org.opencontainers.image.revision="%s" skala.student="sk026"\n' "$SOURCE_REV" >> image-context/Dockerfile
'''
      }
    }
    stage('Image Build & Push (Docker Buildx)') {
      steps {
        withCredentials([usernamePassword(credentialsId: env.DOCKER_CREDENTIAL_ID,
          usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
          sh '''#!/bin/bash
set +x
set -euo pipefail
IMAGE_REF="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}:${FINAL_IMAGE_TAG}"
REG_AUTH_DIR="$(mktemp -d /tmp/sk026-registry.XXXXXX)"
trap 'rm -rf -- "$REG_AUTH_DIR"' EXIT
export DOCKER_CONFIG="$REG_AUTH_DIR"
printf '%s' "$REG_PASS" | docker login --username "$REG_USER" --password-stdin "$IMAGE_REGISTRY_URL"
docker buildx build --platform linux/amd64 --provenance=false --sbom=false \
  --label "org.opencontainers.image.source=$GIT_URL" --label "org.opencontainers.image.revision=$SOURCE_REV" \
  --label skala.student=sk026 --metadata-file "$WORKSPACE/evidence/image-build-metadata.json" \
  --tag "$IMAGE_REF" --push "$WORKSPACE/image-context"
jq -r '."containerimage.digest"' evidence/image-build-metadata.json > evidence/image-digest.txt
test "$(cat evidence/image-digest.txt)" != null
'''
        }
      }
    }
    stage('GitOps Update') {
      steps {
        withCredentials([usernamePassword(credentialsId: env.GIT_ID,
          usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
          sh '''#!/bin/bash
set +x
set -euo pipefail
GITOPS_STATE="$(mktemp -d /tmp/sk026-gitops.XXXXXX)"
trap 'git worktree remove --force "$GITOPS_STATE/tree" >/dev/null 2>&1 || true; rm -rf -- "$GITOPS_STATE"' EXIT
cat > "$GITOPS_STATE/askpass" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' "$GIT_USER" ;;
  *) printf '%s\n' "$GIT_PASS" ;;
esac
ASKPASS
chmod 700 "$GITOPS_STATE/askpass"
export GIT_ASKPASS="$GITOPS_STATE/askpass" GIT_TERMINAL_PROMPT=0
git config credential.helper ''
if git ls-remote --exit-code --heads origin refs/heads/gitops >/dev/null; then
  git fetch origin refs/heads/gitops:refs/remotes/origin/gitops
  GITOPS_BASE=origin/gitops
else
  GITOPS_BASE="$SOURCE_REV"
fi
git worktree add --detach "$GITOPS_STATE/tree" "$GITOPS_BASE"
rm -rf -- "$GITOPS_STATE/tree/kustomize"
cp -R "$WORKSPACE/kustomize" "$GITOPS_STATE/tree/kustomize"
IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"
(cd "$GITOPS_STATE/tree/kustomize/overlays/dev" && kustomize edit set image "${IMAGE_BASE}=${IMAGE_BASE}:${FINAL_IMAGE_TAG}")
mkdir -p "$GITOPS_STATE/tree/k8s"
kubectl kustomize "$GITOPS_STATE/tree/kustomize/overlays/dev" > "$GITOPS_STATE/tree/k8s/rendered.yaml"
cp "$GITOPS_STATE/tree/k8s/rendered.yaml" "$WORKSPACE/evidence/gitops-rendered.yaml"
export IMAGE_DIGEST="$(cat "$WORKSPACE/evidence/image-digest.txt")"
python3 -c 'import json,os;e=os.environ; print(json.dumps({"student":"sk026","namespace":"class-1","image":e["IMAGE_REGISTRY_URL"]+"/"+e["IMAGE_REGISTRY_PROJECT"]+"/"+e["IMAGE_NAME"]+":"+e["FINAL_IMAGE_TAG"],"digest":e["IMAGE_DIGEST"],"source_revision":e["SOURCE_REV"],"tool":e["CI_TOOL"],"job":e["JOB_NAME"],"build_number":e["BUILD_NUMBER"]},indent=2))' > "$GITOPS_STATE/tree/gitops-image.json"
cp "$GITOPS_STATE/tree/gitops-image.json" "$WORKSPACE/evidence/gitops-image.json"
git -C "$GITOPS_STATE/tree" add -- kustomize k8s gitops-image.json
git -C "$GITOPS_STATE/tree" -c user.name=sk026-gitops -c user.email=sk026@users.noreply.github.com commit -m "[sk026 CI] ${CI_TOOL}: ${FINAL_IMAGE_TAG}"
git -C "$GITOPS_STATE/tree" push origin HEAD:refs/heads/gitops
git -C "$GITOPS_STATE/tree" rev-parse HEAD > "$WORKSPACE/evidence/gitops-commit.txt"
'''
        }
      }
    }
  }
  post {
    always { archiveArtifacts artifacts: 'evidence/**', allowEmptyArchive: true; deleteDir() }
    success { echo 'sk026 CI image and GitOps branch update succeeded.' }
  }
}
